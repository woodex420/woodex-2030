            "maxLength": 120
          },
          "utm_campaign": {
            "type": "string",
            "maxLength": 120
          },
          "utm_content": {
            "type": "string",
            "maxLength": 120
          },
          "utm_term": {
            "type": "string",
            "maxLength": 120
          },
          "gclid": {
