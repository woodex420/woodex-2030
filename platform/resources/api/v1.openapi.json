          "url": {
            "description": "The address of its replacement on this site, without its name.",
            "type": "string",
            "pattern": "^/api/v1/media/[0-9]+/[0-9]+$"
          }
        }
      },
      "MediaAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaMapping"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/WholeListMeta"
          }
        }
      },
