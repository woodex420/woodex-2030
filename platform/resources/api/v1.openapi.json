    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A new UUID for each thing you create. Send the same request again with the same key and it is written once and answered the same; a key that was used for other content is refused (409).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "The number of this request, the same as meta.request_id.",
        "schema": {
          "$ref": "#/components/schemas/RequestNumber"
        }
      },
      "IdempotentReplayed": {
        "description": "\"true\" when this create was answered from its first sending and nothing was written now. Absent otherwise.",
        "schema": {
          "type": "string",
          "const": "true"
        }
      },
      "Allow": {
        "description": "The methods this address takes.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "How many seconds to wait.",
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request cannot be read as it is: a query parameter this address does not take (PARAMETER_NOT_ALLOWED), a body that is not a JSON object (BAD_REQUEST), or a create without a UUID in its Idempotency-Key header (IDEMPOTENCY_KEY_REQUIRED).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "NOT_FOUND: nothing is at this address, the record is not there, or this part is switched off on this site.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "IDEMPOTENCY_KEY_REUSED: the key was used before for a request with other content. Or CONFLICT: somebody else was saving the same records in that moment and nothing was saved; send the request again with the same key.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "UNSUPPORTED_MEDIA_TYPE: the body is not sent as JSON.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "VALIDATION_FAILED: a field was refused. details names each refused field with its messages.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "TOO_MANY_REQUESTS.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "SERVER_ERROR: a fault on this side. The answer says nothing about it but the number of the request.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "UNAVAILABLE: this is switched off or not set up at the moment. Ask again later.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
