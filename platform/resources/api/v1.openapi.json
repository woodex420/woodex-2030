            "type": "string",
            "maxLength": 30
          },
          "email": {
            "description": "An e-mail address. One of phone and email is required.",
            "type": "string",
            "maxLength": 160
          },
          "company": {
            "type": "string",
            "maxLength": 160
          },
          "preferred_channel": {
