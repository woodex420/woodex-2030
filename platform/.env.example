# ---------------------------------------------------------------------------
# Woodex OS environment. Copy to .env. NEVER commit .env (the repo is public).
# Production values for Woodex Furniture are not defined yet (docs/laravel-os in this repository).
# ---------------------------------------------------------------------------
APP_NAME="Woodex OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Admin location. Local: http://localhost:8000/admin
# Production: ADMIN_DOMAIN=<the admin host> and ADMIN_PATH= (empty)
ADMIN_DOMAIN=
ADMIN_PATH=admin
PUBLIC_SITE_URL=http://localhost:8000

# Optional modules (config/modules.php): comma-separated keys, or * for all. Everything not listed is closed.
WOODEX_MODULES=lead_api

# Require TOTP 2FA for owner/admin/accountant (always true in production)
ENFORCE_2FA=false

# X-Frame-Options header (keep SAMEORIGIN in production)
SECURITY_FRAME_OPTIONS=SAMEORIGIN

# First owner account for `php artisan woodex:install --no-interaction`
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=woodex_os
# DB_USERNAME=root
# DB_PASSWORD=
DB_TIMEZONE=+05:00

# Old v2.1 database (read-only user) for the importer
LEGACY_DB_DRIVER=mysql
LEGACY_DB_SQLITE_PATH=
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Woodex Interior"

# Public lead API (website forms, live-site bridge)
PUBLIC_LEADS_ALLOWED_ORIGINS=
PUBLIC_LEADS_BRIDGE_KEY=

# Cloudflare Turnstile (spam protection). Leave empty to disable in local dev.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram bot (alerts + commands). Create with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Temporary compatibility only; reconnect the webhook to the header-authenticated URL instead.
TELEGRAM_ALLOW_LEGACY_WEBHOOK=false

# WhatsApp Cloud API (P4: the inbox). From Meta for Developers -> your app -> WhatsApp -> API Setup:
# the temporary or permanent system-user token, the phone number id it sends from, and the WABA id.
# WHATSAPP_APP_SECRET signs the webhook (App settings -> Basic) and WHATSAPP_VERIFY_TOKEN is any string
# you make up and paste into Meta's webhook configuration; the callback URL is /webhooks/whatsapp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

VITE_APP_NAME="${APP_NAME}"

# Google OAuth Web application (private production .env only; no secrets in the UI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SIGN_IN_ENABLED=false
# Optional: Workspace data connection (Drive, Sheets, Gmail, Calendar). Register this exact callback in Google Cloud.
GOOGLE_WORKSPACE_REDIRECT_URI=
GOOGLE_WORKSPACE_SCOPES="openid email https://www.googleapis.com/auth/drive.metadata.readonly https://www.googleapis.com/auth/spreadsheets.readonly https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.readonly"

# Optional disposable SQLite preview only; never enable on an installed/production environment.
# The SQLite filename must start with woodex-synthetic- to expose demo credentials.
WOODEX_SYNTHETIC_PREVIEW=false
WOODEX_PREVIEW_SHOW_CREDENTIALS=false
WOODEX_PREVIEW_LOGIN_EMAIL=
WOODEX_PREVIEW_LOGIN_PASSWORD=

# Transitional 2030 navigation: full HTTPS dashboard base URL, e.g. https://your-host/dashboard
# Separate sign-in; leave blank until verified. No data or authentication sync.
LEGACY_DASHBOARD_URL=
