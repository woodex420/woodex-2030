{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*/)?\\.[^/]+(/.*)?",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)\\.php",
      "dest": "/api/index.php"
    },
    {
      "src": "/(build|builder|fonts|images|sounds)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/assets/(admin-v21|brand|fonts|img|uploads)/(.*)",
      "dest": "/public/assets/$1/$2"
    },
    {
      "src": "/(favicon\\.ico|favicon\\.svg)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "TRUSTED_PROXIES": "*",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "database",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_COOKIE": "woodex_livewire_session",
    "CACHE_STORE": "database",
    "QUEUE_CONNECTION": "database",
    "APP_CONFIG_CACHE": "/tmp/woodex-config.php",
    "APP_EVENTS_CACHE": "/tmp/woodex-events.php",
    "APP_PACKAGES_CACHE": "/tmp/woodex-packages.php",
    "APP_ROUTES_CACHE": "/tmp/woodex-routes.php",
    "APP_SERVICES_CACHE": "/tmp/woodex-services.php"
  }
}
