# Phase 1a synthetic preview of the WOODEX OS source. Disposable. Never commit. Never point at a real database.
APP_NAME="WOODEX OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
ASSET_URL=/
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

ADMIN_DOMAIN=
ADMIN_PATH=admin
PUBLIC_SITE_URL=http://localhost:8080
ENFORCE_2FA=false
# The Arena live preview shows the app in a frame on another site; the frame header is relaxed for this preview only.
SECURITY_FRAME_OPTIONS=
# PDFs open in a frame inside the admin, which is itself framed by the preview host: allow https ancestors here only.
SECURITY_PDF_FRAME_ANCESTORS=https:

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/platform/database/woodex-synthetic-furniture-preview.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="preview@woodex.test"
MAIL_FROM_NAME="Woodex Furniture (synthetic preview)"

# No provider credentials of any kind.
PUBLIC_LEADS_ALLOWED_ORIGINS=
PUBLIC_LEADS_BRIDGE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=none
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOW_LEGACY_WEBHOOK=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SIGN_IN_ENABLED=false

# Normal Fortify sign-in only: no credential display, no direct launcher.
WOODEX_SYNTHETIC_PREVIEW=false
WOODEX_PREVIEW_SHOW_CREDENTIALS=false
WOODEX_PREVIEW_DIRECT_ADMIN=false
VITE_APP_NAME="WOODEX OS"
