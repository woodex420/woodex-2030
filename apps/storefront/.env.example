# Default stays on the existing Node API. Do not change a live deployment without contract acceptance.
VITE_LEAD_API_MODE=legacy

# Optional LOCAL REHEARSAL ONLY (server-side proxy targets, never browser-facing URLs):
# VITE_LEAD_API_MODE=v1
# LARAVEL_LEAD_API_PROXY_TARGET=http://127.0.0.1:8080
# API_PROXY_TARGET=http://127.0.0.1:3002
# Production requires a same-origin reverse proxy to Laravel; current Vercel routes do not supply it.
