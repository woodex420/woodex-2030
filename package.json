{
  "name": "woodex-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/dashboard",
    "apps/storefront"
  ],
  "scripts": {
    "qa": "node scripts/qa-full.mjs",
    "qa-full": "node scripts/qa-full.mjs",
    "e2e": "node scripts/e2e-login.mjs",
    "e2e:storefront-crm": "node scripts/e2e-storefront-crm.mjs",
    "e2e:quotation-template": "node scripts/e2e-quotation-template.mjs",
    "e2e:page-builder": "node scripts/e2e-page-builder.mjs",
    "dev:api": "npm -w @woodex/api run dev",
    "dev:dashboard": "npm -w @woodex/dashboard run dev",
    "dev:storefront": "npm -w @woodex/storefront run dev",
    "dev:preview:api": "PORT=3002 npm run dev:api",
    "dev:preview:dashboard": "ARENA_PREVIEW=1 API_PROXY_TARGET=http://localhost:3002 npm -w @woodex/dashboard run dev -- --port 3001",
    "dev:preview:storefront": "ARENA_PREVIEW=1 API_PROXY_TARGET=http://localhost:3002 npm -w @woodex/storefront run dev -- --port 5174",
    "build": "npm -w @woodex/dashboard run build && npm -w @woodex/storefront run build",
    "vercel:build": "node scripts/build-vercel.mjs",
    "typecheck": "npm -w @woodex/dashboard run build",
    "typecheck:storefront": "npm -w @woodex/storefront exec -- tsc -b",
    "typecheck:all": "npm run typecheck && npm run typecheck:storefront",
    "secret-scan": "node scripts/secret-scan.mjs",
    "smoke:render": "node scripts/smoke-render.mjs",
    "qa:pg": "node scripts/qa-pg.mjs",
    "ci:test": "node scripts/ci-test.mjs",
    "db:apply-schema": "node scripts/apply-postgres-schema.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:verify-backup": "node scripts/backup.mjs --verify",
    "start:hostinger": "WOODEX_SERVE_STATIC=dist node --experimental-sqlite apps/api/server.mjs",
    "smoke:hostinger": "node scripts/smoke-hostinger.mjs",
    "db:migrate": "node scripts/pg-migrate.mjs",
    "seed:data": "node scripts/build-seed-data.mjs",
    "seed:data:check": "node scripts/build-seed-data.mjs --check",
    "check:deploy": "node scripts/check-deploy-config.mjs",
    "test:router": "node scripts/test-router-paths.mjs",
    "check:migration": "node scripts/check-migration-coverage.mjs",
    "docs:verify": "node scripts/verify-docs.mjs",
    "test:integrity": "node scripts/test-integrity.mjs",
    "test:audit": "node scripts/test-audit-schema.mjs",
    "test:blocks": "node scripts/test-block-coverage.mjs",
    "test:public": "node scripts/test-public-surface.mjs",
    "test:stock": "node scripts/test-stock-ledger.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "test:restore": "node scripts/test-restore-drill.mjs",
    "audit:schema": "node scripts/audit-live-schema.mjs",
    "test:audit-log": "node scripts/test-audit-log.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "playwright": "^1.63.0"
  }
}
